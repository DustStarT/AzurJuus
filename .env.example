AZURJUUS_HOST=127.0.0.1
AZURJUUS_PORT=4173
# 不设置 DATABASE_URL 时使用项目内 SQLite；本地桌面无需 Docker。
AZURJUUS_REDIS_URL=
AZURJUUS_CHROMA_URL=
AZURJUUS_CHROMA_COLLECTION=azurjuus_memory
AZURJUUS_CHROMA_PATH=.azurjuus/chroma
# 在软件设置中选择授权工作目录，或取消下一行注释并填写真实路径。
# AZURJUUS_WORKSPACE_ROOT=C:\path\to\your\workspace
AZURJUUS_WORKSPACE_STATE_PATH=.azurjuus/workspace-v2.json
AZURJUUS_LLM_TIMEOUT=45
AZURJUUS_SOCIAL_ENABLED=true
AZURJUUS_SOCIAL_TICK_SECONDS=20
